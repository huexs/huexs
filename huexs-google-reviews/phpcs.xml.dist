<?xml version="1.0"?>
<ruleset name="Huexs Google Reviews">
    <description>WordPress Coding Standards para Huexs Google Reviews.</description>

    <file>huexs-google-reviews.php</file>
    <file>uninstall.php</file>
    <file>src</file>
    <file>templates</file>

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>tests/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>

    <arg value="sp"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>

    <config name="minimum_wp_version" value="6.5"/>
    <config name="testVersion" value="8.1-"/>

    <rule ref="WordPress">
        <!-- PSR-4: nombres de archivo por clase, sin prefijo class-. -->
        <exclude name="WordPress.Files.FileName"/>
        <!-- El proyecto usa camelCase en métodos por decisión de estilo (docs/DECISIONS.md). -->
        <exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName"/>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="huexs-google-reviews"/>
            </property>
        </properties>
    </rule>
</ruleset>
