    {
      "id": "unicos-ok",
      "name": "Mensajes guardados (únicos)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        180
      ],
      "parameters": {
        "jsCode": "// Un mensaje puede traer varias facturas: las etiquetas se aplican una sola vez.\nconst vistos = new Set();\nconst salida = [];\n\nfor (const item of $input.all()) {\n  const messageId = item.json.messageId;\n  if (!messageId || vistos.has(messageId)) continue;\n  vistos.add(messageId);\n  salida.push({ json: { messageId, asunto: item.json.asunto, motivo: item.json.motivo || '' } });\n}\n\nreturn salida;\n"
      }
    },
