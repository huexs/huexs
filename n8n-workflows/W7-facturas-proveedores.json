    {
      "id": "clasificar",
      "name": "Clasificar proveedor y extraer PDF",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        300
      ],
      "parameters": {
        "jsCode": "// Proveedores reconocidos. Para añadir uno nuevo, copia una línea y edítala.\nconst PROVEEDORES = [\n  { slug: 'barnaretols',   remitentes: ['info@barnaretols47.es'] },\n  { slug: 'parking-huexs', remitentes: ['facturas@construll.com'] },\n];\n\nfunction cabecera(json, nombre) {\n  const directo = json[nombre] || json[nombre.toLowerCase()];\n  if (directo) return String(directo);\n  const cabeceras = (json.payload && json.payload.headers) || json.headers || [];\n  if (Array.isArray(cabeceras)) {\n    const encontrada = cabeceras.find(c => String(c.name).toLowerCase() === nombre.toLowerCase());\n    if (encontrada) return String(encontrada.value);\n  } else if (cabeceras && typeof cabeceras === 'object') {\n    const clave = Object.keys(cabeceras).find(k => k.toLowerCase() === nombre.toLowerCase());\n    if (clave) return String(cabeceras[clave]);\n  }\n  return '';\n}\n\nfunction fechaISO(json) {\n  const ms = Number(json.internalDate);\n  const fecha = Number.isFinite(ms) && ms > 0 ? new Date(ms) : new Date(cabecera(json, 'Date') || Date.now());\n  return fecha.toISOString().slice(0, 10);\n}\n\nfunction limpiar(texto) {\n  return String(texto)\n    .toLowerCase()\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/[^a-z0-9-]+/g, '-')\n    .replace(/^-+|-+$/g, '');\n}\n\nconst salida = [];\n\nfor (const item of $input.all()) {\n  const json = item.json;\n  const binarios = item.binary || {};\n  const remitente = cabecera(json, 'From').toLowerCase();\n  const asunto = cabecera(json, 'Subject');\n  const base = { messageId: json.id, threadId: json.threadId, remitente, asunto };\n\n  const proveedor = PROVEEDORES.find(p =>\n    p.remitentes.some(r => remitente.includes(String(r).toLowerCase()))\n  );\n\n  const pdfs = Object.entries(binarios).filter(([, b]) =>\n    String(b.mimeType || '').toLowerCase() === 'application/pdf' ||\n    String(b.fileName || '').toLowerCase().endsWith('.pdf')\n  );\n\n  // Sin proveedor conocido o sin PDF: no se guarda nada, se deriva a revisión.\n  if (!proveedor || pdfs.length === 0) {\n    salida.push({\n      json: {\n        ...base,\n        revisar: true,\n        motivo: !proveedor ? 'proveedor desconocido' : 'sin adjunto PDF',\n      },\n    });\n    continue;\n  }\n\n  const fecha = fechaISO(json);\n  pdfs.forEach(([, binario], indice) => {\n    const origen = limpiar(String(binario.fileName || 'factura').replace(/\\.pdf$/i, ''));\n    const sufijo = pdfs.length > 1 ? `-${indice + 1}` : '';\n    salida.push({\n      json: {\n        ...base,\n        revisar: false,\n        slug: proveedor.slug,\n        nombreFichero: `${fecha}-${proveedor.slug}${origen ? '-' + origen : ''}${sufijo}.pdf`,\n      },\n      binary: { data: binario },\n    });\n  });\n}\n\nreturn salida;\n"
      }
    },
