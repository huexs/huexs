    {
      "id": "clean-phone",
      "name": "Limpiar teléfono",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1780, 420],
      "parameters": {
        "jsCode": "const n = $input.first().json;\nconst raw = (n.phone || '').toString();\nconst digits = raw.replace(/\\D/g, '');\nconst phone9 = digits.length >= 9 ? digits.slice(-9) : digits;\nreturn [{ json: { ...n, phone: phone9 } }];"
      }
    },
