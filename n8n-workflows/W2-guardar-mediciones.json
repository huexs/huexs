    {
      "id": "group-by-tipo-001",
      "name": "Agrupar productos por tipo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        320
      ],
      "parameters": {
        "jsCode": "const normalizado = $input.first().json;\nconst productosArr = normalizado.productos_arr || [];\n\nconst TIPOS = [\n  ['rotulo_standard',       'Rotulo Standard'],\n  ['rotulo_panaflex',       'Rotulo Panaflex'],\n  ['vinilo_cristal',        'Vinilo Cristal'],\n  ['vinilo_microperforado', 'Vinilo Microperforado'],\n  ['forex',                 'Forex'],\n  ['mostrador',             'Mostrador'],\n  ['lona_exterior',         'Lona Exterior'],\n  ['led_caja',              'Caja de Luz LED'],\n  ['otro',                  'Otro elemento']\n];\n\nconst byTipo = {};\nfor (const [tipo] of TIPOS) {\n  const prods = productosArr.filter(p => p.tipo === tipo);\n  byTipo[tipo] = prods.length === 0 ? '' : prods.map(p => {\n    const a = parseFloat(p.anchoCm).toFixed(1);\n    if (p.altoCm != null) {\n      const h = parseFloat(p.altoCm).toFixed(1);\n      const m2 = (parseFloat(a) * parseFloat(h) / 10000).toFixed(3);\n      return `${a} × ${h} cm (${m2} m²)`;\n    }\n    return `${a} cm (solo ancho)`;\n  }).join(' | ');\n}\n\nreturn [{ json: { ...normalizado, byTipo } }];"
      }
    }
  ],
