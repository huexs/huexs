# Copia este fichero a .env y rellena los valores.
# .env NO se sube a Git (está en .gitignore).

# Clave de Google Cloud con Places API (New) habilitada.
# Restríngela en Google Cloud a "Places API (New)" y a la IP de este servidor.
GOOGLE_MAPS_API_KEY=

# Token propio para las rutas /admin (emitir y revocar licencias).
# Genera uno con: openssl rand -hex 32
ADMIN_TOKEN=

# Segundos que se cachea cada negocio antes de volver a pagar una llamada a Google.
# 21600 = 6 horas. Subirlo abarata; bajarlo refresca antes.
CACHE_TTL_SECONDS=21600

DEFAULT_LANGUAGE=es
DEFAULT_REGION=ES
